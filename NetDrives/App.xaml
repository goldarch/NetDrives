    			<ResourceDictionary Source="Shared\Styles\ButtonStyles.xaml"/>
          <ResourceDictionary Source="Shared\Styles\ComboBox.xaml"/>
          <ResourceDictionary Source="Shared\Styles\Sliders.xaml"/>
          <ResourceDictionary Source="Shared\Styles\MenuStyles.xaml" />
          <ResourceDictionary Source="Shared\Menus\MenuResources.xaml" />
          <ResourceDictionary Source="Shared\Styles\GridStyles.xaml"/>
    		</ResourceDictionary.MergedDictionaries>
    	</ResourceDictionary>
         
    </Application.Resources>
</Application>
