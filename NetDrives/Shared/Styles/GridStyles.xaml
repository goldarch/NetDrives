<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:prim="clr-namespace:Microsoft.Windows.Controls.Primitives;assembly=WPFToolkit"
  xmlns:dg="clr-namespace:Microsoft.Windows.Controls;assembly=WPFToolkit"
  >


  <!-- default data grid style -->
  <Style
    TargetType="{x:Type dg:DataGrid}">
    <Setter
      Property="Background"
      Value="{DynamicResource GridBackgroundBrush}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Foreground}" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource GridBorderBrush}" />
    <Setter
      Property="HorizontalGridLinesBrush"
      Value="{DynamicResource CellBorderBrush}" />
    <Setter
      Property="VerticalGridLinesBrush"
      Value="{DynamicResource CellBorderBrush}" />
    <Setter
      Property="AutoGenerateColumns"
      Value="False" />
    <Setter
      Property="CanUserReorderColumns"
      Value="False" />
    <Setter
      Property="CanUserResizeColumns"
      Value="True" />
    <Setter
      Property="IsReadOnly"
      Value="True" />
    <Setter
      Property="RowBackground"
      Value="{DynamicResource CellBackground}" />
    <Setter
      Property="HeadersVisibility"
      Value="Column" />
    <Setter
      Property="SelectionMode"
      Value="Single" />
    <Setter
      Property="RowHeight"
      Value="28" />
    <Setter
      Property="FontSize"
      Value="14" />
    <Setter
      Property="HorizontalScrollBarVisibility"
      Value="Disabled" />
    <Setter
      Property="GridLinesVisibility"
      Value="All" />
    <Setter
      Property="HorizontalAlignment"
      Value="Left" />
    <Setter
      Property="VerticalAlignment"
      Value="Center" />
  </Style>

  <!--  x:Key="ColumnHeaderStyle"-->
  <Style
    TargetType="{x:Type prim:DataGridColumnHeader}">
    <Setter
      Property="Background"
      Value="{DynamicResource GridColumnHeaderBackground}" />
    <Setter
      Property="Height"
      Value="30" />
    <Setter
      Property="Padding"
      Value="2,0,0,0" />
    <Setter
      Property="FontWeight"
      Value="Bold" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Foreground}" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource ColumnHeaderBorder}" />
    <Setter
      Property="BorderThickness"
      Value="0,0,0,1" />
    <Setter
      Property="VerticalContentAlignment"
      Value="Center" />
  </Style>


  <!-- default style for data grid rows -->
  <Style
    TargetType="{x:Type dg:DataGridRow}">

    <Setter
      Property="Validation.ErrorTemplate"
      Value="{x:Null}" />
  </Style>


  <!-- custom style for the unmanaged connections grid -->
  <Style
    x:Key="UnmanagedConnectionsGridRow"
    TargetType="{x:Type dg:DataGridRow}">

    <Setter
      Property="ContextMenu"
      Value="{DynamicResource SystemConnectionsContextMenu}" />

  </Style>

  <!-- custom style for the managed connections grid -->
  <Style
    x:Key="ManagedConnectionsGridRow"
    TargetType="{x:Type dg:DataGridRow}">

    <Setter
      Property="ContextMenu"
      Value="{DynamicResource ManagedConnectionsContextMenu}" />

  </Style>

  <!-- custom declares the context menu for the popup grid -->
  <Style
    x:Key="TrayConnectionsGridRow"
    TargetType="{x:Type dg:DataGridRow}">

    <Setter
      Property="ContextMenu"
      Value="{DynamicResource TrayConnectionsContextMenu}" />

  </Style>
  


  <!-- Cell Settings -->
  <Style
    TargetType="{x:Type dg:DataGridCell}">
    <Setter
      Property="BorderThickness"
      Value="0" />

    <Style.Triggers>
      <Trigger
        Property="IsSelected"
        Value="True">
        <Setter
          Property="Foreground"
          Value="{DynamicResource ActiveCellForeground}" />
        <Setter
          Property="Background"
          Value="{DynamicResource ActiveCellBackground}" />
      </Trigger>
    </Style.Triggers>
  </Style>


  <!-- Row Header Template (Selection) --> 
  <Style
    x:Key="{x:Type prim:DataGridRowHeader}"
    TargetType="{x:Type prim:DataGridRowHeader}">
    <Setter
      Property="Background"
      Value="{DynamicResource GridRowHeaderBackground}" />
    <Setter
      Property="ToolTip"
      Value="Click and drag row to change default order." />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="{x:Type prim:DataGridRowHeader}">
          <Grid>
            <dg:DataGridHeaderBorder
              IsSelected="{TemplateBinding IsRowSelected}"
              IsHovered="{TemplateBinding IsMouseOver}"
              IsPressed="{TemplateBinding IsPressed}"
              BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type dg:DataGrid}},
                                    Path=HorizontalGridLinesBrush}"
              Background="{TemplateBinding Background}"
              BorderThickness="0,1,0,0"
              Padding="{TemplateBinding Padding}"
              Orientation="Horizontal"
              SeparatorVisibility="{TemplateBinding SeparatorVisibility}"
              SeparatorBrush="{TemplateBinding SeparatorBrush}"
              Margin="0,-1,0,0">

              <StackPanel
                Orientation="Horizontal">
                <ContentPresenter
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                  VerticalAlignment="Center" />
              </StackPanel>
            </dg:DataGridHeaderBorder>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="{StaticResource ActiveGridRowHeaderBackground}" />
            </Trigger>
            <Trigger
              Property="IsRowSelected"
              Value="True">
              <Setter
                Property="Background"
                Value="{StaticResource ActiveGridRowHeaderBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


</ResourceDictionary>