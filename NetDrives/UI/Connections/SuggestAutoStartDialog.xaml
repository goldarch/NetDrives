<Window x:Class="Hardcodet.NetDrives.UI.Connections.SuggestAutoStartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Auto-Start" Height="323" Width="426" Style="{DynamicResource DialogWindow}" Background="{DynamicResource DialogBackgroundBrush}" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" AllowsTransparency="False">
    <Grid>
    	<TextBlock
    		Height="Auto"
    		TextWrapping="Wrap"
    		Style="{DynamicResource TitleLabel}" HorizontalAlignment="Left" Margin="10,19,0,0" VerticalAlignment="Top"><Run Text="Enable Automatic Startup?" Language="de-ch"/></TextBlock>
    	<TextBlock
    		Margin="10,50.28,10,0"
    		TextWrapping="Wrap"
    		Style="{DynamicResource DefaultLabel}" HorizontalAlignment="Stretch" VerticalAlignment="Top" d:LayoutOverrides="Width"><Run Text="You enabled auto-connection for this share, but you still have to start NetDrives manually."/><LineBreak/><Run Text=""/><LineBreak/><Run Text="NetDrives can start automatically when you log on to Windows and run in the background. Do you want to enable this feature now?"/></TextBlock>
    	<CheckBox Margin="10,0,0,12.32" VerticalAlignment="Bottom" Content="Do not ask me again" x:Name="chkSuppressMessage" HorizontalAlignment="Left" d:LayoutOverrides="Width"/>
    	<Button
    		x:Name="btnOk"
    		Click="btnOk_Click"
    		HorizontalAlignment="Right"
    		Margin="0,0,10,12.32"
    		Width="90"
    		Content="OK"
    		VerticalAlignment="Bottom"
    		Height="21.68"
    		IsDefault="True"
    		TabIndex="10" />
    	<TextBlock
    		Margin="42,0,0,83.38"
    		TextWrapping="Wrap"
    		HorizontalAlignment="Left"
    		Style="{DynamicResource DefaultLabel}"
    		Width="Auto"
    		Height="23"
    		VerticalAlignment="Bottom"><Run Text="Yes, always start NetDrives automatically with Windows" Language="de-ch"/></TextBlock>
    	<RadioButton
    		HorizontalAlignment="Left"
    		Margin="10,0,0,80.38"
    		Width="20"
    		Content=""
    		IsChecked="True"
    		Height="23"
    		VerticalAlignment="Bottom"
    		x:Name="rbAutoStart" TabIndex="3" />
    	<TextBlock
    		Margin="42,0,0,60.38"
    		TextWrapping="Wrap"
    		Style="{DynamicResource DefaultLabel}"
    		Width="Auto"
    		Height="23"
    		VerticalAlignment="Bottom" HorizontalAlignment="Left" d:LayoutOverrides="Width"><Run Text="No, I want to start NetDrives manually" Language="de-ch"/></TextBlock>
    	<RadioButton
    		Margin="10,0,0,57.38"
    		Content=""
    		VerticalAlignment="Bottom"
    		Height="23"
    		x:Name="rbManualStart" TabIndex="4" Width="20" HorizontalAlignment="Left" />
    </Grid>
</Window>
