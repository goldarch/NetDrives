<Window
  x:Class="Hardcodet.NetDrives.UI.Connections.DisconnectionErrorDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{ext:Resource DisconnectionError_Window_Title}"
  Height="269"
  Width="434"
  Style="{DynamicResource DialogWindow}"
  WindowStartupLocation="CenterOwner"
  x:Name="me"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  xmlns:ext="clr-namespace:Hardcodet.NetDrives.Shared.MarkupExtensions">
  <Grid>

    <!-- 标题 -->
    <TextBlock
      Margin="10,14,10,0"
      Style="{DynamicResource TitleLabel}"
      VerticalAlignment="Top"
      TextWrapping="Wrap">
      <Run Text="{ext:Resource DisconnectionError_Title_Prefix}" />
      <InlineUIContainer>
        <TextBlock Text="{Binding ElementName=me, Path=ShareName}" TextWrapping="Wrap" />
      </InlineUIContainer>
      <Run Text="{ext:Resource DisconnectionError_Title_Suffix}" />
    </TextBlock>
    <TextBlock
      Margin="40,133,10,0"
      TextWrapping="Wrap"
      HorizontalAlignment="Stretch"
      Style="{DynamicResource DefaultLabel}"
      Width="Auto"
      VerticalAlignment="Top"
      Height="23"><Run
        Language="de-ch"
        Text="{ext:Resource DisconnectionError_Option_Normal}" /></TextBlock>
    <Button
      x:Name="btnCancel"
      Click="btnCancel_Click"
      HorizontalAlignment="Right"
      Margin="0,0,10,10"
      Width="90"
      Content="{ext:Resource Common_Cancel}"
      VerticalAlignment="Bottom"
      Height="21.68"
      TabIndex="2" />
    <Button
      x:Name="btnDisconnect"
      Click="btnDisconnect_Click"
      Margin="0,0,110,10"
      Content="{ext:Resource Grid_Action_Disconnect}"
      VerticalAlignment="Bottom"
      Height="21.68"
      IsDefault="True"
      Width="90"
      HorizontalAlignment="Right"
      TabIndex="1" />
    <RadioButton
      x:Name="rbCloseNormal"
      HorizontalAlignment="Left"
      Margin="10,136,0,0"
      Width="20"
      Content=""
      IsChecked="True"
      VerticalAlignment="Top"
      Height="23"
      TabIndex="3" />
    <TextBlock
      Margin="40,166,10,0"
      TextWrapping="Wrap"
      Style="{DynamicResource DefaultLabel}"
      Width="Auto"
      VerticalAlignment="Top"
      Height="23"
      d:LayoutOverrides="Width"
      Text="{ext:Resource DisconnectionError_Option_Force}" />
    <RadioButton
      x:Name="rbCloseForced"
      HorizontalAlignment="Left"
      Margin="10,169,0,0"
      Width="20"
      Content=""
      VerticalAlignment="Top"
      Height="23"
      TabIndex="4" />
    <!-- 选项与说明 -->
    <TextBlock
      Margin="10,64.28,13,0"
      Style="{DynamicResource DefaultLabel}"
      VerticalAlignment="Top"
      TextWrapping="Wrap"
      Text="{ext:Resource DisconnectionError_Description}" />
    <Image HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="72" Height="72" Opacity="0.36" Source="..\..\Shared\Images\Error.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
    	<Image.RenderTransform>
    		<TransformGroup>
    			<ScaleTransform ScaleX="1" ScaleY="1"/>
    			<SkewTransform AngleX="0" AngleY="0"/>
    			<RotateTransform Angle="32.218"/>
    			<TranslateTransform X="0" Y="0"/>
    		</TransformGroup>
    	</Image.RenderTransform>
    </Image>

  </Grid>
</Window>
