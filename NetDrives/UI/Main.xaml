<igRibbon:XamRibbonWindow
  x:Class="Hardcodet.NetDrives.UI.Main"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="NetDrives"
  Height="600"
  Width="950"
  xmlns:dg="http://schemas.microsoft.com/wpf/2008/toolkit"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:Converters="clr-namespace:Hardcodet.NetDrives.Shared.Converters;assembly="
  xmlns:igRibbon="http://infragistics.com/Ribbon"
  mc:Ignorable="d"
  MinWidth="350"
  MinHeight="300"
  SizeChanged="CacheWindowLocation"
  StateChanged="CacheWindowLocation"
  LocationChanged="CacheWindowLocation"
  Background="{DynamicResource WindowBackgroundBrush}"
  xmlns:ext="clr-namespace:Hardcodet.NetDrives.Shared.MarkupExtensions">

  <igRibbon:RibbonWindowContentHost Ribbon="{StaticResource MainMenu}"
                                    Background="{DynamicResource WindowBackgroundBrush}">
      
  <Grid x:Name="layoutRoot">

    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>


<!--    ItemsSource="{Binding Path=ShareManager.Shares}"-->
    <dg:DataGrid
      x:Name="shareGrid"
      ItemsSource="{Binding Path=ShareManager.Shares}"
      SelectedItem="{Binding Path=ActiveShare}"
      RowStyle="{DynamicResource ManagedConnectionsGridRow}"
      MouseDoubleClick="OnDoubleClick"
      Margin="10,51,10,11"
      CanUserSortColumns="False"
      IsSynchronizedWithCurrentItem="True"
      VerticalAlignment="Stretch"
      Grid.Row="1"
      RowHeaderWidth="40"
      MinHeight="80"
      Background="{x:Null}">
      
      <dg:DataGrid.Columns>

        <!-- Status -->
        <dg:DataGridTemplateColumn
          Header=""
          SortMemberPath="Status"
          IsReadOnly="True"
          Width="30"
          CanUserResize="False">

          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Source="{Binding Path=Status, Converter={Converters:ConnectionStatusToImageConverter}}"
                ToolTip="{Binding Path=ConnectionResult, Converter={Converters:EnumToDescriptionConverter}}" />
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>

        <!-- Auto-Connect -->
        <dg:DataGridTemplateColumn
          Header=""
          IsReadOnly="True"
          CanUserResize="False"
          Width="30"
          SortMemberPath="Configuration.AutoConnect">

          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image
                SnapsToDevicePixels="False"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Source="{Binding Path=Configuration.AutoConnect, Converter={Converters:AutoConnectToImageConverter}}" />
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>

        <!-- Name -->
        <dg:DataGridTextColumn
          IsReadOnly="True"
          Header="{ext:Resource Grid_Column_Name}"
          Width="*"
          FontWeight="Bold"
          MinWidth="100"
          Binding="{Binding Path=Configuration.Name}" />

        <!-- Drive Letter -->
        <dg:DataGridTextColumn
          Header="{ext:Resource Grid_Column_Drive}"
          IsReadOnly="True"
          Width="50"
          CanUserResize="False"
          Binding="{Binding Path=Configuration.DriveLetter, Converter={Converters:DriveLetterConverter}}" />

        <!-- Host Name -->
        <dg:DataGridTextColumn
          SortMemberPath="ConnectionInfo.HostEntry.HostName"
          Header="{ext:Resource Grid_Column_Host}"
          IsReadOnly="True"
          Width="150"
          Binding="{Binding Path=ConnectionInfo.HostEntry.HostName, Converter={Converters:StringToUpperConverter}}" />

        <!-- Network Path -->
        <dg:DataGridTextColumn
          Header="{ext:Resource Grid_Column_NetworkPath}"
          IsReadOnly="True"
          Width="2*"
          Binding="{Binding Path=Configuration.NetworkLocation}" />

        <!-- User Login -->
        <dg:DataGridTemplateColumn
          Header="{ext:Resource Grid_Column_UserLogin}"
          IsReadOnly="True"
          MinWidth="150"
          Width="*">

          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock
                x:Name="txt"
                Margin="2,0,0,0"
                Text="{Binding Path=Credentials.UserName}"
                 />
              <DataTemplate.Triggers>
                <DataTrigger
                  Binding="{Binding Path=UsesDefaultLogin}" Value="False">
                  <Setter
                    TargetName="txt"
                    Property="Foreground"
                    Value="{DynamicResource CustomLoginForeground}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>

      </dg:DataGrid.Columns>
    </dg:DataGrid>

    
    <TextBlock
      Margin="10,20,10,0"
      TextWrapping="Wrap"
      VerticalAlignment="Top"
      Height="22"
      Grid.Row="1"
      Style="{DynamicResource TitleLabel}"
      Text="{ext:Resource Main_ConfiguredConnections_Title}" />

    <Expander
      Header="{ext:Resource Main_UnmanagedConnections_Header}"
      Margin="10,10,10,10"
      x:Name="expander1"
      Grid.Row="2"
      IsExpanded="True"
      VerticalAlignment="Stretch"
      ExpandDirection="Down"
      Opacity="0.81"
      d:LayoutOverrides="Height, Margin" Collapsed="expander1_Collapsed">
      <dg:DataGrid
        ItemsSource="{Binding Path=ShareManager.UnmanagedConnections}"
        Margin="-1,6,-1,0"
        IsSynchronizedWithCurrentItem="True"
        Height="Auto"
        RowStyle="{DynamicResource UnmanagedConnectionsGridRow}"
        MinHeight="80" VerticalAlignment="Stretch">


        <dg:DataGrid.Columns>

          <!-- Host Name -->
          <dg:DataGridTextColumn
            Header="{ext:Resource Grid_Column_Host}"
            IsReadOnly="True"
            Width="150"
            Binding="{Binding Path=HostEntry.HostName, Converter={Converters:StringToUpperConverter}}" />

          <!-- Drive -->
          <dg:DataGridTextColumn
            Header="{ext:Resource Grid_Column_Drive}"
            IsReadOnly="True"
            Width="50"
            Binding="{Binding Path=Connection.LocalName}" />

          <!-- Network Path -->
          <dg:DataGridTextColumn
            Header="{ext:Resource Grid_Column_NetworkPath}"
            IsReadOnly="True"
            Width="2*"
            Binding="{Binding Path=Connection.RemotePath}" />

          <!-- User Login -->
          <dg:DataGridTextColumn
            Header="{ext:Resource Grid_Column_UserLogin}"
            IsReadOnly="True"
            Width="*"
            Binding="{Binding Path=Connection.UserName}" />

          <!-- Status -->
          <dg:DataGridTextColumn
            Header="{ext:Resource Grid_Column_Status}"
            IsReadOnly="True"
            Width="100"
            Binding="{Binding Path=Connection.ConnectionState}" />

        </dg:DataGrid.Columns>

      </dg:DataGrid>
    </Expander>

    <GridSplitter
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Width="Auto"
      Height="4"
      Grid.Row="2"
      ResizeDirection="Rows"
      IsEnabled="{Binding Path=IsExpanded, ElementName=expander1, Mode=Default}" Background="{DynamicResource GridBorderBrush}" />
    
  </Grid>
    
  </igRibbon:RibbonWindowContentHost>
  </igRibbon:XamRibbonWindow>