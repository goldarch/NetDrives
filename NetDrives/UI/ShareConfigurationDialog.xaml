<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Hardcodet.NetDrives.UI.ShareConfigurationDialog"
  x:Name="Window"
  Title="{ext:Resource ShareConfig_WindowTitle}"
  Width="420"
  Height="547"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:conv="clr-namespace:Hardcodet.NetDrives.Shared.Converters"
  xmlns:ext="clr-namespace:Hardcodet.NetDrives.Shared.MarkupExtensions"
  mc:Ignorable="d"
  WindowStartupLocation="CenterOwner"
  Style="{DynamicResource DialogWindow}"
  FocusManager.FocusedElement="{Binding ElementName=txtShareName}">
  <Window.Triggers>
  </Window.Triggers>

  <Grid
    x:Name="LayoutRoot">

    <Grid.RowDefinitions>
      <RowDefinition
        Height="0.92*" />
      <RowDefinition
        Height="0.08*" />
    </Grid.RowDefinitions>
    <TextBlock
      Margin="10,19,0,0"
      VerticalAlignment="Top"
      TextWrapping="Wrap"
      Style="{DynamicResource TitleLabel}" HorizontalAlignment="Left" d:LayoutOverrides="Width"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_ShareSettings}" /></TextBlock>
    <TextBlock
      Margin="10,229.68,201,216.32"
      TextWrapping="Wrap"
      Style="{DynamicResource TitleLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_SecuritySettings}" /></TextBlock>
    <TextBlock
      Margin="10,73,0,0"
      VerticalAlignment="Top"
      Height="23"
      TextWrapping="Wrap"
      HorizontalAlignment="Left"
      Width="Auto"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_ShareName}" /></TextBlock>
    <TextBlock
      Margin="10,106,0,0"
      VerticalAlignment="Top"
      Height="23"
      TextWrapping="Wrap"
      HorizontalAlignment="Left"
      Width="Auto"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_NetworkAddress}" /></TextBlock>
    <TextBlock
      Margin="10,139,0,0"
      VerticalAlignment="Top"
      Height="23"
      TextWrapping="Wrap"
      HorizontalAlignment="Left"
      Width="Auto"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_DriveLetterOptional}" /></TextBlock>
    <TextBlock
      Margin="10,273,0,0"
      TextWrapping="Wrap"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Width="Auto"
      Height="23"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_LoginAsUserOptional}" /></TextBlock>
    <TextBox
      Margin="179,73,10,0"
      VerticalAlignment="Top"
      Height="23"
      Text="{Binding Path=Name, ValidatesOnDataErrors=True}"
      TextWrapping="NoWrap"
      FontWeight="Bold"
      x:Name="txtShareName"
      TabIndex="1" />
    <TextBox
      Margin="179,106,10,0"
      VerticalAlignment="Top"
      Height="23"
      TextWrapping="NoWrap"
      Text="{Binding Path=NetworkLocation, ValidatesOnDataErrors=True}"
      x:Name="txtNetworkAddress"
      TabIndex="2" />
    <TextBox
      Margin="179,273,10,0"
      Text="{Binding Path=UserName}"
      TextWrapping="NoWrap"
      VerticalAlignment="Top"
      Height="23"
      x:Name="txtUserName" />
    <TextBlock
      Margin="56,0,0,59.32"
      TextWrapping="Wrap"
      VerticalAlignment="Bottom"
      Height="23"
      HorizontalAlignment="Left"
      Width="Auto"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_Password}" /></TextBlock>
    <TextBlock
      Margin="56,0,0,26.32"
      TextWrapping="Wrap"
      VerticalAlignment="Bottom"
      Height="23"
      HorizontalAlignment="Left"
      Width="Auto"
      Style="{DynamicResource DefaultLabel}"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_PasswordConfirmation}" /></TextBlock>
    <Button
      x:Name="btnCancel"
      Click="Cancel"
      HorizontalAlignment="Right"
      Margin="0,10,10,0"
      Width="90"
      Content="{ext:Resource Common_Cancel}"
      Grid.Row="1"
      VerticalAlignment="Top"
      Height="21.68"
      TabIndex="11" />
    <Button
      x:Name="btnOk"
      Click="CommitChanges"
      HorizontalAlignment="Right"
      Margin="0,10,109,0"
      Width="90"
      Content="{ext:Resource Common_OK}"
      Grid.Row="1"
      VerticalAlignment="Top"
      Height="21.68"
      IsDefault="True"
      TabIndex="10" />
    <RadioButton
      Margin="10,309,0,0"
      VerticalAlignment="Top"
      Height="23"
      Content=""
      Width="24"
      HorizontalAlignment="Left"
      x:Name="rbNoPasswordRequired"
      Click="OnLoginTypeChanged"
      TabIndex="5" />
    <RadioButton
      Margin="10,338,0,0"
      VerticalAlignment="Top"
      Height="23"
      Content=""
      Width="24"
      HorizontalAlignment="Left"
      x:Name="rbPromptForPassword"
      Click="OnLoginTypeChanged"
      TabIndex="6" />
    <RadioButton
      Margin="10,367,0,0"
      Height="23"
      Content=""
      Width="24"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      x:Name="rbAutoLogin"
      Click="OnLoginTypeChanged"
      TabIndex="7" />
    <TextBlock
      Margin="10,172,109,0"
      VerticalAlignment="Top"
      Height="23"
      TextWrapping="Wrap"
      Style="{DynamicResource DefaultLabel}" HorizontalAlignment="Left"><Run
        Language="de-ch"
        Text="{ext:Resource ShareConfig_AutoConnectAtStartup}" /></TextBlock>
    <CheckBox
      HorizontalAlignment="Right"
      Margin="0,177,10,0"
      VerticalAlignment="Top"
      d:LayoutOverrides="Width"
      IsChecked="{Binding Path=AutoConnect}"
      IsEnabled="{Binding Path=IsAutoConnectEnabled}"
      x:Name="chkAutoConnect"
      TabIndex="4" />
    <ComboBox
      x:Name="cboDriveLetter"
      SelectedValue="{Binding Path=DriveLetter}"
      IsEnabled="{Binding Path=IsDriveLetterAllowed}"
      HorizontalAlignment="Right"
      Margin="0,139,10,0"
      VerticalAlignment="Top"
      IsSynchronizedWithCurrentItem="True"
      Width="70"
      Height="23"
      IsEditable="False"
      TabIndex="3" />
    <PasswordBox
      PasswordChanged="OnPasswordChanged"
      Margin="0,0,10,59.32"
      VerticalAlignment="Bottom"
      Width="160"
      HorizontalAlignment="Right"
      Height="23"
      x:Name="txtPassword"
      IsEnabled="{Binding Path=IsChecked, ElementName=rbAutoLogin, Mode=Default, FallbackValue=False}"
      TabIndex="8" />
    <PasswordBox
      x:Name="txtPasswordConfirmation"
      PasswordChanged="OnPasswordChanged"
      HorizontalAlignment="Right"
      Margin="0,0,10,26.32"
      VerticalAlignment="Bottom"
      Width="160"
      Height="23"
      IsEnabled="{Binding Path=IsChecked, ElementName=rbAutoLogin, Mode=Default, FallbackValue=False}"
      TabIndex="9" />
    <TextBlock
      Margin="34,0,0,92.32"
      TextWrapping="Wrap"
      VerticalAlignment="Bottom"
      Height="23"
      Style="{DynamicResource DefaultLabel}"
      HorizontalAlignment="Left"
      Text="{ext:Resource ShareConfig_LoginMode_Auto}" />

    <TextBlock
      Margin="34,0,0,121.32"
      TextWrapping="Wrap"
      VerticalAlignment="Bottom"
      Height="23"
      Style="{DynamicResource DefaultLabel}"
      HorizontalAlignment="Left"
      Text="{ext:Resource ShareConfig_LoginMode_Prompt}" />

    <TextBlock
      Margin="34,0,0,150.32"
      TextWrapping="Wrap"
      VerticalAlignment="Bottom"
      Height="23"
      Style="{DynamicResource DefaultLabel}"
      HorizontalAlignment="Left"
      Text="{ext:Resource ShareConfig_LoginMode_None}" />
    <Path
      Fill="#FFFFFFFF"
      Stretch="Fill"
      Margin="10,205,10,0"
      VerticalAlignment="Top"
      Height="1"
      Data="M11,209 L405.01142,209"
      Stroke="{DynamicResource SeparatorStroke}" />
    <Image
      HorizontalAlignment="Right"
      Margin="0,10,10,0"
      VerticalAlignment="Top"
      Width="51.204"
      Height="51.204"
      Source="..\Shared\Images\NetDrives.png"
      Stretch="Fill"
      RenderTransformOrigin="0.57,1.035"
      Opacity="0.745" />
    <Image
      HorizontalAlignment="Right"
      Margin="0,140,112,0"
      VerticalAlignment="Top"
      Source="..\Shared\Images\WarningSmall.png"
      Stretch="Uniform"
      ToolTip="{ext:Info Body=Warning_About_Disabled_Drive_Letters_For_Host_Locations}"
      Width="22"
      Height="22"
      Opacity="0.64"
      Visibility="{Binding Path=IsDriveLetterAllowed, Converter={conv:BoolToVisibilityConverter}, ConverterParameter=x}"
      x:Name="imdDriveLetterWarning" />
    <Image
      HorizontalAlignment="Right"
      Margin="0,173,58,0"
      VerticalAlignment="Top"
      Source="..\Shared\Images\WarningSmall.png"
      Stretch="Uniform"
      ToolTip="{ext:Info Body=Warning_About_Disabled_Auto_Connections}"
      Visibility="{Binding Path=IsAutoConnectEnabled, Converter={conv:BoolToVisibilityConverter}, ConverterParameter=x}"
      Width="22"
      Height="22"
      Opacity="0.64"
      x:Name="imgAutoConnectWarning" />
    <Image
      HorizontalAlignment="Left"
      Margin="156,107,0,0"
      VerticalAlignment="Top"
      Width="22"
      Height="22"
      Source="..\Shared\Images\HelpSmall.png"
      Stretch="Fill"
      Opacity="0.3"
      x:Name="imgAddressInfo"
      ToolTip="{ext:Info Title=ToolTip_Title_For_Network_Address_Samples,
                        Body=ToolTip_With_Network_Address_Samples}" />
    <Image
      Margin="156,75,0,0"
      VerticalAlignment="Top"
      Height="22"
      Source="..\Shared\Images\HelpSmall.png"
      Stretch="Fill"
      Opacity="0.3"
      x:Name="imgShareNameInfo"
      ToolTip="{ext:Info Body=ToolTip_Explaining_Share_Name, Title=ToolTip_Title_Share_Name}"
      HorizontalAlignment="Left"
      Width="22" />
    <Image
      Margin="0,140,80,0"
      VerticalAlignment="Top"
      Height="22"
      Source="..\Shared\Images\HelpSmall.png"
      Stretch="Fill"
      Opacity="0.3"
      x:Name="imgDriveLetterInfo"
      ToolTip="{ext:Info Body=ToolTip_Explaining_Drive_Letters, Title=ToolTip_Title_Drive_Letter}"
      HorizontalAlignment="Right"
      Width="22" />
    <Image
      Margin="0,173,26,0"
      VerticalAlignment="Top"
      Height="22"
      Source="..\Shared\Images\HelpSmall.png"
      Stretch="Fill"
      Opacity="0.3"
      x:Name="imgAutoConnectInfo"
      ToolTip="{ext:Info Body=ToolTip_Explaining_Auto_Connect, Title=ToolTip_Title_Auto_Connect}"
      HorizontalAlignment="Right"
      Width="22" />

  </Grid>
</Window>