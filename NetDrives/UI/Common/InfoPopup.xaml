<UserControl
  x:Class="Hardcodet.NetDrives.UI.Common.InfoPopup"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="169"
  d:DesignHeight="79"
  x:Name="me"
  Opacity="0.895">
  <Border
    Margin="5,5,5,5"
    Background="{DynamicResource DialogBackgroundBrush}"
    BorderBrush="{DynamicResource PopupBorderBrush}"
    BorderThickness="1,1,1,1">
    <Border.Effect>
      <DropShadowEffect
        Color="#FF393939" />
    </Border.Effect>
    <Grid
      MinHeight="68"
      MinWidth="160"
      MaxWidth="300">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*" />
      </Grid.RowDefinitions>

      <TextBlock
        HorizontalAlignment="Left"
        Margin="52,10,10,0"
        x:Name="txtTitle"
        TextWrapping="Wrap"
        d:LayoutOverrides="Width"
        Style="{DynamicResource TitleLabel}"
        FontSize="14"
        Text="{Binding ElementName=me, Path=HeaderText}"
        VerticalAlignment="Top"
        Visibility="Collapsed" />
      <Image
        HorizontalAlignment="Left"
        Margin="0,10,0,0"
        VerticalAlignment="Top"
        Width="48"
        Height="48"
        Source="..\..\Shared\Images\Info.png"
        Stretch="Fill"
        Grid.Row="0"
        Grid.RowSpan="2" />
      <TextBlock
        Margin="52,10,10,10"
        VerticalAlignment="Top"
        TextWrapping="Wrap"
        HorizontalAlignment="Left"
        x:Name="txtInfo"
        d:LayoutOverrides="VerticalAlignment, Width"
        Style="{DynamicResource DefaultLabel}"
        FontSize="12"
        Text="{Binding ElementName=me, Path=BodyText}"
        Grid.Row="1" />

    </Grid>
  </Border>
</UserControl>
