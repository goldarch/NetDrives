<Window
  x:Class="Hardcodet.NetDrives.UI.Common.AboutDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="About"
  Height="360"
  Width="480"
  Background="{x:Null}"
  WindowStyle="None"
  WindowStartupLocation="CenterOwner"
  AllowsTransparency="True"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <Window.Resources>
    <Style
      TargetType="{x:Type Hyperlink}">
      <Setter
        Property="Foreground"
        Value="{DynamicResource TitleForeground}" />
      <Setter
        Property="TextDecorations"
        Value="None" />
      <Setter
        Property="ToolTip"
        Value="Visit website" />
    </Style>
    <Storyboard
      x:Key="OnLoaded1">
      <DoubleAnimationUsingKeyFrames
        BeginTime="00:00:00"
        Storyboard.TargetName="MainBorder"
        Storyboard.TargetProperty="(UIElement.Opacity)">
        <SplineDoubleKeyFrame
          KeyTime="00:00:00"
          Value="0.21" />
        <SplineDoubleKeyFrame
          KeyTime="00:00:00.5000000"
          Value="1"
          KeySpline="0.43,0,0.545,0.869" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger
      RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard
        Storyboard="{StaticResource OnLoaded1}" />
    </EventTrigger>
  </Window.Triggers>

  <!-- main border -->
  <Border
    x:Name="MainBorder"
    Hyperlink.RequestNavigate="OnNavigationRequest"
    Width="450"
    Height="330"
    BorderThickness="0"
    CornerRadius="12,12,12,12"
    Opacity="0.21">
    <Border.Effect>
      <DropShadowEffect
        Color="#FF9BA8B4"
        ShadowDepth="5"
        Opacity="0.6" />
    </Border.Effect>
    <Border.Background>
      <LinearGradientBrush
        StartPoint="0.126,-0.197"
        EndPoint="0.874,1.197">
        <GradientStop
          Offset="0"
          Color="#FF8FA6C2" />
        <GradientStop
          Offset="1"
          Color="#FFB3CDED" />
        <GradientStop
          Offset="0.284"
          Color="#FFEEEEEE" />
        <GradientStop
          Offset="0.365"
          Color="#FFEEEEEE" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="55.5" />
        <RowDefinition
          Height="110" />
        <RowDefinition
          Height="*" />
        <RowDefinition
          Height="50" />
      </Grid.RowDefinitions>
      <Border
        x:Name="HeaderBorder"
        Grid.Row="0"
        Background="#35BDCCDC"
        BorderThickness="0"
        CornerRadius="12,12,0,0" />
      <StackPanel
        Grid.Row="0"
        Orientation="Horizontal"
        HorizontalAlignment="Center">
        <TextBlock
          x:Name="HeaderText"
          Margin="8,0,8,0"
          VerticalAlignment="Center"
          FontSize="30"
          Foreground="#FF434343"
          HorizontalAlignment="Stretch"
          TextAlignment="Center"
          Width="Auto"><TextBlock.Effect>
        		<DropShadowEffect
              Color="#FF8DA3BC"
              ShadowDepth="3" />
        	</TextBlock.Effect><Run
            Language="de-ch"
            Text="NetDrives" /></TextBlock>
      </StackPanel>


      <!-- version information etc -->
      <StackPanel
        Grid.Row="1"
        Margin="30,20,0,0">
        <TextBlock><InlineUIContainer>
        		<TextBlock><Run
                Language="de-ch"
                Text="NetDrives" /></TextBlock>
        	</InlineUIContainer><Run
            Text=" " /><InlineUIContainer>
        		<TextBlock
              x:Name="txtVersion" />
        	</InlineUIContainer></TextBlock>
        <TextBlock
          Margin="0,4,0,0"><Run
            Language="de-ch"
            Text="Copyright " /><Run
            Text="© " /><Run
            Language="de-ch"
            Text="2009 Philipp Sumi" /></TextBlock>
        <TextBlock
          Margin="0,4,0,0"><Hyperlink
            NavigateUri="http://www.hardcodet.net/netdrives/"><Run
              Text="http://www.hardcodet.net/netdrives" /></Hyperlink></TextBlock>

          <TextBlock
              Margin="0,4,0,0">
              <Run Text="优化及汉化: GoldArch " />
              <Hyperlink NavigateUri="https://github.com/goldarch">
                  <Run Text="https://github.com/goldarch" />
              </Hyperlink>
          </TextBlock>
            </StackPanel>

      <Border
        Grid.Row="2"
        BorderThickness="0,1,0,0"
        BorderBrush="{DynamicResource SeparatorStroke}">

        <!-- license information etc -->
        <StackPanel
          Grid.Row="1"
          Margin="30,15,0,0">
          <TextBlock
            Margin="0,0,0,10"><Run
              Language="de-ch"
              Text="NetDrives" /><Run
              Text=" makes use of free software:" /></TextBlock>
          <TextBlock><Hyperlink
              NavigateUri="http://www.everaldo.com/"><Run
                Text="Crystal Clear Icon Set" /></Hyperlink><Run
              Text=" " /><InlineUIContainer>
          		<TextBlock
                Text="- © Everaldo Coelho" />
          	</InlineUIContainer></TextBlock>
          <TextBlock><Hyperlink
              NavigateUri="http://www.nanolx.org/oxygenrefit-2/"><Run
                Text="Oxygen Refit" /></Hyperlink><Run
              Text=" " /><InlineUIContainer>
          		<TextBlock
                Text="- © Christopher Bratusek / Oxygen Team" />
          	</InlineUIContainer></TextBlock>
          <TextBlock><Hyperlink
              NavigateUri="http://www.icon-king.com/"><Run
                Text="Nuvola Icon Set" /></Hyperlink><Run
              Text=" " /><InlineUIContainer>
          		<TextBlock
                Text="- © David Vignoni" />
          	</InlineUIContainer></TextBlock>
        </StackPanel>

      </Border>


      <Border
        x:Name="FooterBorder"
        Grid.Row="3"
        Background="#38BDCCDC"
        BorderThickness="0"
        CornerRadius="0,0,12,12" />

      <Button
        x:Name="btnOk"
        Click="btnOk_Click"
        Width="90"
        Height="24"
        Grid.Row="3"
        Margin="0,0,10,10"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        IsDefault="True"
        Content="OK" />

      <Image
        HorizontalAlignment="Left"
        Margin="10,4.296,0,0"
        Width="51.204"
        Source="..\..\Shared\Images\NetDrives.png"
        Stretch="Fill" />

    </Grid>
  </Border>

</Window>
