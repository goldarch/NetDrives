<Window x:Class="Hardcodet.NetDrives.UI.Common.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing..."
        Width="400"
        Height="141"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Opacity="1"
        WindowStyle="None"
        Background="{x:Null}"
        ShowInTaskbar="False">
	<Window.Resources>
		<Storyboard x:Key="OnLoaded1" AutoReverse="True" RepeatBehavior="Forever">
			<DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="imgStatus" Storyboard.TargetProperty="(UIElement.Opacity)">
				<SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
				<SplineDoubleKeyFrame KeyTime="00:00:01.6000000" Value="0.305"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
	</Window.Resources>
	<Window.Triggers>
		<EventTrigger RoutedEvent="FrameworkElement.Loaded">
			<BeginStoryboard Storyboard="{StaticResource OnLoaded1}"/>
		</EventTrigger>
	</Window.Triggers>

  <Border CornerRadius="12,12,12,12"
          BorderBrush="#FF020202"
          BorderThickness="0,0,0,0"
          Height="122" Opacity="1">
    <Border.Background>
      <LinearGradientBrush EndPoint="0.874,1.197"
                           StartPoint="0.126,-0.197">
        <GradientStop Color="#FFB3CDED"
                      Offset="0" />
        <GradientStop Color="#FFB4CEED"
                      Offset="1" />
        <GradientStop Color="#FFF9FBFD"
                      Offset="0.284" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <ProgressBar Margin="114,83,10,0"
                   x:Name="progressBar"
                   Foreground="#FFFFA609"
                   VerticalAlignment="Top"
                   Height="14" />
      <Image Margin="10,15,0,0"
             x:Name="imgStatus"
             Stretch="Uniform"
             Source="..\..\Shared\Images\Network.png"
             VerticalAlignment="Top"
             HorizontalAlignment="Left"
             Width="94"
             Height="85"
             Opacity="1" />
      <TextBlock Margin="114,8,10,0"
                 Text="A background operation is in progress. Please wait..."
                 x:Name="txtDialogMessage"
                 VerticalAlignment="Top"
                 Height="Auto"
                 Foreground="{DynamicResource TitleForeground}"
                 FontSize="14"
                 TextWrapping="Wrap" Style="{DynamicResource DefaultLabel}" FontWeight="Bold" HorizontalAlignment="Left" />
      <DockPanel
                 Margin="12,73,10,82">
        <Button x:Name="btnCancel"
                Click="btnCancel_Click"
                Visibility="Collapsed"
                Content="Cancel"
                DockPanel.Dock="Right"
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right" />
        <Label x:Name="lblStatus"
               Foreground="#FFCCCCCC"
               Content="Work in progress. Please stand by..." />
      </DockPanel>
    </Grid>
  </Border>
</Window>
